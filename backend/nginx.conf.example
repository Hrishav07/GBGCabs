# ==============================================================================
# GoBabyGo Cabs - Nginx Production Server Block Example
# Save to: /etc/nginx/sites-available/gbgcabs.com
# Symlink: ln -s /etc/nginx/sites-available/gbgcabs.com /etc/nginx/sites-enabled/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY SERVER BLOCK (Valid before requesting SSL certificate)
# Run `sudo nginx -t && sudo systemctl reload nginx` before running certbot:
# `sudo certbot --nginx -d gbgcabs.com -d www.gbgcabs.com`
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name gbgcabs.com www.gbgcabs.com api.gbgcabs.com;

    # Point directly at the deployed frontend (Vite production build)
    root /var/www/gbgcabs/dist;
    index index.html;

    # Charset & Logs
    charset utf-8;
    access_log /var/log/nginx/gbgcabs_access.log;
    error_log /var/log/nginx/gbgcabs_error.log error;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json text/plain text/css application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Let's Encrypt / Certbot ACME Webroot Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        allow all;
    }

    # Route site-root API requests to backend/api directory
    location ^~ /api/ {
        alias /var/www/gbgcabs/backend/api/;
        try_files $uri $uri/ $uri.php =404;

        location ~ \.php$ {
            include snippets/fastcgi-php.conf;
            fastcgi_pass unix:/var/run/php/php8.3-fpm.sock; # Adjust PHP-FPM socket version if needed
            fastcgi_param SCRIPT_FILENAME $request_filename;
            include fastcgi_params;
        }
    }

    # Block Access to Sensitive Backend Files & Folders
    location ~* /(\.env|\.git|database/.*\.sql|config/|data/|helpers/|models/) {
        deny all;
        return 404;
    }

    # Cache Static Assets (Vite build dist)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Frontend Single Page Application / Static Assets Fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ------------------------------------------------------------------------------
# 2. POST-SSL CONFIGURATION (Auto-configured by Certbot)
# Once certificates are issued with `certbot --nginx`, Certbot will automatically
# create or manage the SSL 443 server block below:
# ------------------------------------------------------------------------------
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name gbgcabs.com www.gbgcabs.com api.gbgcabs.com;
#
#     ssl_certificate /etc/letsencrypt/live/gbgcabs.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/gbgcabs.com/privkey.pem;
#     include /etc/letsencrypt/options-ssl-nginx.conf;
#     ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
#
#     root /var/www/gbgcabs/dist;
#     index index.html;
#     ...
# }
