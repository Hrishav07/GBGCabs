# ==============================================================================
# GoBabyGo Cabs (GBG EV / GBG X) - Environment Configuration
# ==============================================================================

# Application Mode: development | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated list of frontends allowed to connect)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings
# DB_DRIVER: mysql (primary) or file (automatic fallback if MySQL is offline)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gbg_cabs_db
DB_USER=root
DB_PASS=

# JWT / Security Token Key (Change this to a strong 32+ character random string in production)
JWT_SECRET=gbg_super_secret_production_key_change_me_2026_xyz!

# Initial Admin Credentials (Generated automatically during first migration)
ADMIN_NAME="GBG Fleet Administrator"
ADMIN_EMAIL=admin@gbgcabs.com
ADMIN_PASSWORD=Admin@GBG2026!

# Email / Notification Settings (Optional - set true to send confirmation emails via SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@gbgcabs.com
SMTP_FROM_NAME="GoBabyGo Cabs"
